# Server-side only - never exposed to the browser.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the default Gemini model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: tried in order when the model above is overloaded or out of quota.
# Free-tier quota and downtime are both per model, so a few spread the risk.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash

# Header naming the real client IP, injected by a proxy the client cannot bypass.
# Defaults to x-vercel-forwarded-for on Vercel; set it if you front the app with
# your own proxy. Without one, per-IP rate limiting degrades to a global ceiling.
TRUSTED_CLIENT_IP_HEADER=

# Optional: override the Rick and Morty API base URL (e.g. for a mirror or proxy).
RICKANDMORTY_API_BASE=https://rickandmortyapi.com/api
